{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sda/dataset_manifest.schema.json",
  "title": "SoundDirectionAssist Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "license",
    "clips"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clip_id",
          "audio_path",
          "sha256",
          "event_class",
          "direction_bin",
          "session_id",
          "split_group",
          "split",
          "audio_profile",
          "rights"
        ],
        "properties": {
          "clip_id": {
            "type": "string",
            "minLength": 1
          },
          "audio_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sample_rate_hz": {
            "type": "integer",
            "const": 48000
          },
          "channels": {
            "type": "integer",
            "const": 2
          },
          "event_class": {
            "type": "string",
            "minLength": 1
          },
          "direction_bin": {
            "enum": [
              "unknown",
              "left",
              "center",
              "right",
              "front",
              "front_left",
              "front_right",
              "back",
              "back_left",
              "back_right"
            ]
          },
          "azimuth_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "distance_bucket": {
            "enum": [
              "unknown",
              "near",
              "mid",
              "far"
            ]
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "split_group": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "audio_profile": {
            "type": "string",
            "minLength": 1
          },
          "capture_mode": {
            "enum": [
              "process_loopback",
              "endpoint_loopback",
              "direct_export",
              "synthetic"
            ]
          },
          "rights": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

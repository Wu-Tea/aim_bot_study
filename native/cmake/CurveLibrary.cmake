# Legacy config names retain their exact response. Data is owned by the curve
# library JSON, shared with the desktop. Native generation uses CMake only.
set(_curve_generated "// Generated from resources/curves. Do not edit.\n#pragma once\n#include <array>\nnamespace controller_native::curve_library_data {\n")
foreach(_curve cod_dynamic_legacy cod_linear_legacy)
    set(_curve_file "${PROJECT_SOURCE_DIR}/../resources/curves/${_curve}.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_curve_file}")
    file(READ "${_curve_file}" _curve_json)
    string(JSON _curve_count LENGTH "${_curve_json}" points)
    math(EXPR _curve_last "${_curve_count}-1")
    foreach(_axis 0 1)
        string(APPEND _curve_generated "inline constexpr std::array<float, ${_curve_count}> ${_curve}_${_axis}{")
        foreach(_point RANGE ${_curve_last})
            string(JSON _value GET "${_curve_json}" points ${_point} ${_axis})
            string(APPEND _curve_generated "static_cast<float>(${_value}),")
        endforeach()
        string(APPEND _curve_generated "};\n")
    endforeach()
endforeach()
string(APPEND _curve_generated "}\n")
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/curve_library_data.h" CONTENT "${_curve_generated}" @ONLY)

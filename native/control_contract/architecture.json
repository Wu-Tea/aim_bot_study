{
  "schema_version": 1,
  "architecture_id": "native.direct_reducer_control",
  "version": 3,
  "status": "current",
  "description": "Single synchronous controller chain. Reducer snapshots are passed directly; no runtime event bus, shadow event buffer, or parallel phase cursor exists.",
  "runtime_entry": "runtime_app::RuntimeLoop::run_once",
  "flow": [
    "InputEdgeReducer::sample",
    "AimScopeReducer::reduce",
    "AdsReacquisitionReducer",
    "TargetCoordinator::update",
    "AdsAcquisitionController|BodylockFollowController",
    "AimDynamicsShaper::shape",
    "AssistControlStateMachine::update",
    "AutoFireGate::reduce",
    "RecoilReducer::reduce",
    "OutputComposer::compose",
    "VirtualGamepad::update"
  ],
  "state_ownership": [
    {"state": "input.edge_history", "owner": "InputEdgeReducer"},
    {"state": "input.aim_scope", "owner": "AimScopeReducer"},
    {"state": "ads.reacquisition_request", "owner": "AdsReacquisitionReducer"},
    {"state": "target.identity", "owner": "TargetLifecycleReducer"},
    {"state": "target.geometry_r", "owner": "TargetGeometryReducer"},
    {"state": "target.desired_point_d", "owner": "DesiredPointReducer"},
    {"state": "ads.lifecycle", "owner": "AdsLifecycleReducer"},
    {"state": "target.plan", "owner": "TargetCoordinator"},
    {"state": "assist.pre_recoil_stick", "owner": "AssistControlStateMachine"},
    {"state": "fire.synthetic_command", "owner": "AutoFireGate"},
    {"state": "recoil.contribution", "owner": "RecoilReducer"},
    {"state": "output.gamepad_state", "owner": "OutputComposer"}
  ],
  "event_snapshots": [
    {
      "id": "input.edges.v2",
      "producer": "InputEdgeReducer",
      "consumer": "AimScopeReducer",
      "type": "controller_native::InputEdgeSnapshot"
    },
    {
      "id": "ads.reacquisition.v2",
      "producer": "AdsReacquisitionReducer",
      "consumer": "NativeGamepadController",
      "type": "controller_native::AdsReacquisitionDecision"
    },
    {
      "id": "vision.observation_batch.v1",
      "producer": "NativeGamepadController::observation_batch_from",
      "consumer": "TargetCoordinator",
      "type": "pipeline_contract::VisionObservationBatch"
    }
  ],
  "output_commands": [
    "pipeline_contract::PreRecoilStickCommand",
    "pipeline_contract::FireCommand",
    "pipeline_contract::RecoilContribution",
    "pipeline_contract::AuxiliaryDpadCommand"
  ],
  "invariants": [
    "Only OutputComposer creates or mutates GamepadOutputState.",
    "AssistControlStateMachine is the only pre-recoil manual/AI arbiter.",
    "RecoilReducer cannot read target, desired point, manual input, AI proposal, or pre-recoil output.",
    "Input edges are emitted once per physical state transition, including LT changes while manual-fire scope remains active.",
    "Only settled ADS acquisition may transition to BodyLock; watchdog and center crossing are diagnostic.",
    "Telemetry observes finalized state and cannot write control state."
  ],
  "forbidden_structures": [
    "general-purpose observer/event bus on the control path",
    "shadow event buffers that are not consumed by reducers",
    "parallel phase cursors duplicating OutputComposer ordering",
    "legacy output writer or alternate final stick",
    "config-selectable old/new control owners"
  ]
}
